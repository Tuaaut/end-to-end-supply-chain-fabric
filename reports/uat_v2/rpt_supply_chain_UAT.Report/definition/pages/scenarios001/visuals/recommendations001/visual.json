                                ]
                            },
                            {
                                "textRuns": [
                                    {
                                        "value": "2. Close the OTIF gap — prioritize dispatch-time fixes for carriers below the fleet average OTIF % before committing to a service-level target.",
                                        "textStyle": {
                                            "fontSize": "11pt"
                                        }
                                    }
                                ]
