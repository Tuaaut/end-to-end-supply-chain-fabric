table gld_fact_demand_forecast
	lineageTag: 2b7eaa16-4316-4819-8ee3-0c6ca4341a67
	sourceLineageTag: [dbo].[gld_fact_demand_forecast]

	measure 'Forecast Qty' = SUM('gld_fact_demand_forecast'[Forecast Quantity])
		formatString: '#,0'
		lineageTag: 4bb01dc5-e7f5-499d-bd5e-d1e56628f154

	measure 'Actual Demand Qty' = SUM('gld_fact_demand_forecast'[Actual Demand Quantity])
		formatString: '#,0'
		lineageTag: 97f53383-34ec-43b8-93ad-1b427443f706

	measure 'Forecast Accuracy' = 1 - DIVIDE(SUMX('gld_fact_demand_forecast', ABS('gld_fact_demand_forecast'[Forecast Error Quantity])), SUM('gld_fact_demand_forecast'[Actual Demand Quantity]))
		formatString: 0.0%
		lineageTag: 09e0e87c-9805-460d-a94a-f7ee89cb981e

