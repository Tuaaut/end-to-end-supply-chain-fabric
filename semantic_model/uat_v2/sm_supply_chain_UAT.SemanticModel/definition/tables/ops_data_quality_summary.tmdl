table ops_data_quality_summary
	lineageTag: 2c28fa3f-5d0c-4fd2-9d6b-31df1afef8e1
	sourceLineageTag: [dbo].[ops_data_quality_summary]

	measure 'DQ Score' = CALCULATE(MAX('ops_data_quality_summary'[Actual Value]), 'ops_data_quality_summary'[Table Name] = "__pipeline__", 'ops_data_quality_summary'[Check Name] = "dq_score")
		formatString: 0.0

	measure 'Latest DQ Check' = MAX('ops_data_quality_summary'[Checked At])
		formatString: dd MMM HH:mm

	measure 'Failed Checks' = CALCULATE(COUNTROWS('ops_data_quality_summary'), 'ops_data_quality_summary'[Status] = "FAIL", 'ops_data_quality_summary'[Table Name] <> "__pipeline__")
		formatString: #,0

	measure 'Warning Checks' = CALCULATE(COUNTROWS('ops_data_quality_summary'), 'ops_data_quality_summary'[Status] = "WARNING", 'ops_data_quality_summary'[Table Name] <> "__pipeline__")
		formatString: #,0

	measure 'Quarantined Rows' = CALCULATE(SUM('ops_data_quality_summary'[Actual Value]), 'ops_data_quality_summary'[Check Name] = "quarantined_rows")
		formatString: #,0

	measure 'Checks Evaluated' = CALCULATE(COUNTROWS('ops_data_quality_summary'), 'ops_data_quality_summary'[Table Name] <> "__pipeline__")
		formatString: #,0

	measure 'Latest DQ Status' = VAR LatestCheck = CALCULATE(MAX('ops_data_quality_summary'[Checked At]), ALL('ops_data_quality_summary')) VAR FailedCount = CALCULATE(COUNTROWS('ops_data_quality_summary'), 'ops_data_quality_summary'[Checked At] = LatestCheck, 'ops_data_quality_summary'[Status] = "FAIL") VAR WarningCount = CALCULATE(COUNTROWS('ops_data_quality_summary'), 'ops_data_quality_summary'[Checked At] = LatestCheck, 'ops_data_quality_summary'[Status] = "WARNING") RETURN IF(FailedCount > 0, "FAIL", IF(WarningCount > 0, "WARNING", "PASS"))

