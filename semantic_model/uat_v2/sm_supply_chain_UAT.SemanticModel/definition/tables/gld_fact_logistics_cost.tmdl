table gld_fact_logistics_cost
	lineageTag: 51660b0a-ff17-4c58-94d6-1d3dd4b0e40c
	sourceLineageTag: [dbo].[gld_fact_logistics_cost]

	measure 'Total Logistics Cost' = SUM('gld_fact_logistics_cost'[Amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3c96d1f4-1f1b-4ae0-a840-4691f0f07b48

	measure 'Freight Cost' = CALCULATE(SUM('gld_fact_logistics_cost'[Amount]), 'gld_fact_logistics_cost'[Cost Component] = "FREIGHT")
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d5e6f708-9142-4b34-cd45-6e7f80914253

	measure 'Fuel Surcharge Cost' = CALCULATE(SUM('gld_fact_logistics_cost'[Amount]), 'gld_fact_logistics_cost'[Cost Component] = "FUEL_SURCHARGE")
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e6f70891-4253-4c45-de56-7f8091425364

	measure 'Warehouse Handling Cost' = CALCULATE(SUM('gld_fact_logistics_cost'[Amount]), 'gld_fact_logistics_cost'[Cost Component] = "WAREHOUSE_HANDLING")
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f7089142-5364-4d56-ef67-809142536475

	measure 'Cost per Order' = DIVIDE([Total Logistics Cost], DISTINCTCOUNT('gld_fact_logistics_cost'[Order ID]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 08914253-6475-4e67-f078-91425364758a

	measure 'Cost per Shipment' = DIVIDE([Total Logistics Cost], DISTINCTCOUNT('gld_fact_logistics_cost'[Shipment ID]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 19425364-758a-4f78-0189-425364758a9b

	measure 'Scenario Logistics Cost' = [Total Logistics Cost] * (1 - 'Cost Savings Target %'[Cost Savings Target % Value])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 33457f1f-bd72-46a9-82ce-ea6a29626746

	measure 'Logistics Cost Savings' = [Total Logistics Cost] - [Scenario Logistics Cost]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 15b45c20-63e3-4f90-a949-1c2f575522ec

