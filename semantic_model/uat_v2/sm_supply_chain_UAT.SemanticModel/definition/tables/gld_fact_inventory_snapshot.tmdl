table gld_fact_inventory_snapshot
	lineageTag: 650cfee0-2c39-45c2-b4c2-6cc508714c60
	sourceLineageTag: [dbo].[gld_fact_inventory_snapshot]

	measure 'On Hand Qty' = SUM('gld_fact_inventory_snapshot'[On Hand Quantity])
		formatString: #,0
		lineageTag: 5c05fa93-35f7-4e5a-b759-1bb302e7f00e

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Available Qty' = SUM('gld_fact_inventory_snapshot'[Available Quantity])
		formatString: '#,0'
		lineageTag: b0ee93b1-fe8b-4a57-9736-1480049e3b3b

	measure 'Low Stock Snapshot Count' = COUNTROWS(FILTER('gld_fact_inventory_snapshot', 'gld_fact_inventory_snapshot'[Available Quantity] < 'gld_fact_inventory_snapshot'[Safety Stock Quantity]))
		formatString: #,0
		lineageTag: 862c9a62-0eb3-454f-aa20-1d793ef3f2ca

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

