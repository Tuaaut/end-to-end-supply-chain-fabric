ref table gld_fact_demand_forecast
ref table gld_fact_inventory_snapshot
ref table gld_dim_supplier
ref table gld_dim_carrier
ref table gld_dim_location
ref table gld_dim_product
ref table gld_fact_purchase_receipt
ref table ops_data_quality_summary
ref table ops_pipeline_run_log
ref table ops_incremental_file_watermark
ref table ops_gold_input_watermark
